# Copy to .env. Nothing here is read by the frontend: these exist only in the
# service's environment, and .env is gitignored.

PORT=3000

# Comma-separated origins allowed to call the API (the site hosting the demo).
CORS_ORIGINS=http://localhost:5173

# Largest upload accepted, in bytes. Checked before any provider is called.
MAX_UPLOAD_BYTES=10485760

# --- OCR ---------------------------------------------------------------------
# Default provider: tesseract | azure-document-intelligence
OCR_PROVIDER=tesseract
OCR_PROVIDER_TIMEOUT_MS=60000
OCR_PAGE_CONCURRENCY=2

# Tesseract (self-hosted, no credential). Trained data is fetched on first use.
TESSERACT_LANGS=ara+eng
TESSERACT_CACHE_DIR=.cache/tessdata

# Azure AI Document Intelligence. Set both or neither.
# Endpoint looks like https://<resource>.cognitiveservices.azure.com
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
